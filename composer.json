{
  "name": "dcp/form-builder",
  "description": "DCP Form Builder",
  "version": "0.3.0-alpha.0",
  "type": "library",
  "require": {
    "spatie/laravel-data": "^4.18"
  },
  "autoload": {
    "psr-4": {
      "Dcp\\": "src/"
    }
  },
  "authors": [
    {
      "name": "DCP Core Team",
      "email": "info@open-dcp.ai"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "orchestra/testbench": "^10.8"
  },
  "autoload-dev": {
